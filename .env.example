# Copy to .env (gitignored, chmod 600) and fill in.

# make install: the gaming PC (an SSH host with Windows OpenSSH) and its AddOns folder.
INSTALL_HOST=
ADDONS_DIR=

# make release: CurseForge Authors > API Tokens, and the project ID from the project page.
CURSEFORGE_TOKEN=
CURSEFORGE_PROJECT_ID=
# alpha, beta or release
RELEASE_TYPE=beta
# CurseForge game version type for WoW Forever: an upload goes only to this type.
CURSEFORGE_GAME_VERSION_TYPE=88568
